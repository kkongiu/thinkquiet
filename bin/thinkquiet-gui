#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Interfaccia grafica di ThinkQuiet (PySide6).

- Icona nel vassoio con menu rapido a 4 profili
- Finestra con selettore, statistiche live e ripristino automatico
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QProcess, QSize, Qt, QTimer, Signal
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtGui import QAction, QActionGroup, QColor, QFont, QIcon, QPainter, QPixmap
from PySide6.QtWidgets import (
    QApplication,
    QButtonGroup,
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QMenu,
    QMessageBox,
    QPushButton,
    QSizePolicy,
    QSlider,
    QSystemTrayIcon,
    QVBoxLayout,
    QWidget,
)

HELPER = (
    os.environ.get("THINKQUIET_BIN")
    or shutil.which("thinkquiet")
    or "/usr/local/bin/thinkquiet"
)

FALLBACK_PROFILES = [
    {
        "key": "risparmio",
        "label": "Risparmio",
        "desc": "Turbo off · max 1,2 GHz · ventola auto",
        "color": "#2e7d32",
    },
    {
        "key": "intermedio",
        "label": "Intermedio",
        "desc": "Turbo on · max 2,7 GHz · ventola auto",
        "color": "#1565c0",
    },
    {
        "key": "potente",
        "label": "Potente",
        "desc": "Turbo on · max 3,6 GHz · ventola auto",
        "color": "#c62828",
    },
    {
        "key": "sera",
        "label": "Sera",
        "desc": "AC/batteria adattivo · ventola silenziosa",
        "color": "#6a1b9a",
    },
]

AUTO_COLOR = "#6e6e6e"

TUNING_FILE = os.environ.get(
    "THINKQUIET_TUNING_FILE", "/var/lib/thinkquiet/user/tuning.json"
)
TUNING_DEFAULTS = {
    "sera_ac_max_mhz": 2000,
    "sera_ac_fan_base": 0,
    "sera_ac_temp_mid": 68,
    "sera_bat_max_mhz": 900,
    "sera_bat_temp_mid": 62,
}


def fmt_ghz(value: int) -> str:
    return f"{value / 1000:.1f} GHz".replace(".", ",")


def fmt_temp(value: int) -> str:
    return f"{value} °C"


def fmt_fan(value: int) -> str:
    return "Spenta" if value == 0 else f"Liv. {value}"


def rgba(hex_color: str, alpha: float) -> str:
    color = QColor(hex_color)
    return f"rgba({color.red()},{color.green()},{color.blue()},{alpha})"


def make_letter_icon(color: str, letter: str, size: int = 64) -> QIcon:
    pixmap = QPixmap(size, size)
    pixmap.fill(Qt.transparent)
    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.setPen(Qt.NoPen)
    painter.setBrush(QColor(color))
    margin = max(2, size // 16)
    painter.drawEllipse(margin, margin, size - 2 * margin, size - 2 * margin)
    painter.setPen(QColor("white"))
    font = QFont()
    font.setBold(True)
    font.setPixelSize(int(size * 0.52))
    painter.setFont(font)
    painter.drawText(pixmap.rect(), Qt.AlignCenter, letter)
    painter.end()
    return QIcon(pixmap)


def make_app_icon() -> QIcon:
    return make_letter_icon("#1565c0", "T", 128)


class ProfileButton(QPushButton):
    def __init__(self, info: dict, parent: QWidget | None = None):
        super().__init__(parent)
        self.key = info["key"]
        self.color = info.get("color", "#1565c0")
        self.setObjectName("profileButton")
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.setIcon(make_letter_icon(self.color, info["label"][0].upper(), 48))
        self.setIconSize(QSize(42, 42))
        self.setText(f"{info['label']}\n{info.get('desc', '')}")
        self.setMinimumHeight(88)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.setStyleSheet(
            f"""
            QPushButton {{
                text-align: left;
                padding: 10px 14px;
                border: 2px solid {rgba('#808080', 0.35)};
                border-radius: 12px;
                background: {rgba('#808080', 0.06)};
            }}
            QPushButton:hover {{
                border-color: {self.color};
                background: {rgba(self.color, 0.10)};
            }}
            QPushButton:checked {{
                border: 3px solid {self.color};
                background: {rgba(self.color, 0.18)};
            }}
            QPushButton:disabled {{
                color: {rgba('#808080', 0.7)};
            }}
            """
        )


class StatCard(QFrame):
    def __init__(self, title: str, parent: QWidget | None = None):
        super().__init__(parent)
        self.setObjectName("statCard")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 8, 10, 8)
        layout.setSpacing(2)
        label = QLabel(title)
        label.setObjectName("statTitle")
        self.value = QLabel("—")
        self.value.setObjectName("statValue")
        font = QFont("monospace")
        font.setStyleHint(QFont.Monospace)
        font.setPointSizeF(11)
        font.setBold(True)
        self.value.setFont(font)
        layout.addWidget(label)
        layout.addWidget(self.value)
        self.setStyleSheet(
            f"""
            QFrame#statCard {{
                border: 1px solid {rgba('#808080', 0.25)};
                border-radius: 10px;
                background: {rgba('#808080', 0.05)};
            }}
            QLabel#statTitle {{
                color: {rgba('#808080', 0.95)};
                font-size: 9pt;
            }}
            QLabel#statValue {{
                font-size: 12pt;
            }}
            """
        )


class TuningRow(QWidget):
    def __init__(
        self,
        title: str,
        minimum: int,
        maximum: int,
        step: int,
        formatter,
        parent: QWidget | None = None,
    ):
        super().__init__(parent)
        self._formatter = formatter
        self._dragging = False
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(8)

        label = QLabel(title)
        label.setMinimumWidth(105)
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(minimum, maximum)
        self.slider.setSingleStep(step)
        self.slider.setPageStep(step)
        self.value_label = QLabel(formatter(self.slider.value()))
        self.value_label.setMinimumWidth(70)
        self.value_label.setAlignment(Qt.AlignRight | Qt.AlignVCenter)

        layout.addWidget(label)
        layout.addWidget(self.slider, 1)
        layout.addWidget(self.value_label)

        self.slider.valueChanged.connect(self._on_value_changed)
        self.slider.sliderPressed.connect(self._on_press)
        self.slider.sliderReleased.connect(self._on_release)

    def _on_value_changed(self, value: int) -> None:
        self.value_label.setText(self._formatter(value))

    def _on_press(self) -> None:
        self._dragging = True

    def _on_release(self) -> None:
        self._dragging = False

    def value(self) -> int:
        return self.slider.value()

    def set_value(self, value: int) -> None:
        self.slider.blockSignals(True)
        self.slider.setValue(int(value))
        self.slider.blockSignals(False)
        self.value_label.setText(self._formatter(self.slider.value()))

    def is_dragging(self) -> bool:
        return self._dragging


class SeraTuning(QFrame):
    changed = Signal()
    reset_requested = Signal()

    def __init__(self, parent: QWidget | None = None):
        super().__init__(parent)
        self.setObjectName("tuningPanel")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(14, 12, 14, 12)
        outer.setSpacing(8)

        title = QLabel("Fine tuning Sera")
        title.setObjectName("tuningTitle")
        subtitle = QLabel(
            "Solo profilo Sera · il watchdog termico resta sempre attivo"
        )
        subtitle.setObjectName("tuningSubtitle")
        subtitle.setWordWrap(True)
        outer.addWidget(title)
        outer.addWidget(subtitle)

        columns = QHBoxLayout()
        columns.setSpacing(18)

        ac_col = QVBoxLayout()
        ac_col.setSpacing(6)
        ac_title = QLabel("Con alimentatore")
        ac_title.setObjectName("tuningColumn")
        ac_col.addWidget(ac_title)
        self.ac_max = TuningRow("CPU max", 1200, 2700, 100, fmt_ghz)
        self.ac_fan = TuningRow("Ventola base", 0, 3, 1, fmt_fan)
        self.ac_temp = TuningRow("Soglia ventola", 60, 78, 1, fmt_temp)
        for row in (self.ac_max, self.ac_fan, self.ac_temp):
            ac_col.addWidget(row)
        ac_col.addStretch(1)
        columns.addLayout(ac_col, 1)

        bat_col = QVBoxLayout()
        bat_col.setSpacing(6)
        bat_title = QLabel("A batteria")
        bat_title.setObjectName("tuningColumn")
        bat_col.addWidget(bat_title)
        self.bat_max = TuningRow("CPU max", 600, 1700, 100, fmt_ghz)
        self.bat_temp = TuningRow("Soglia ventola", 55, 75, 1, fmt_temp)
        for row in (self.bat_max, self.bat_temp):
            bat_col.addWidget(row)
        bat_col.addStretch(1)
        columns.addLayout(bat_col, 1)

        outer.addLayout(columns)

        footer = QHBoxLayout()
        hint = QLabel("Valori più alti = più prestazioni e più calore")
        hint.setObjectName("tuningSubtitle")
        footer.addWidget(hint, 1)
        reset = QPushButton("Ripristina default")
        reset.setCursor(Qt.PointingHandCursor)
        reset.clicked.connect(self.reset_requested)
        footer.addWidget(reset)
        outer.addLayout(footer)

        self.rows = {
            "sera_ac_max_mhz": self.ac_max,
            "sera_ac_fan_base": self.ac_fan,
            "sera_ac_temp_mid": self.ac_temp,
            "sera_bat_max_mhz": self.bat_max,
            "sera_bat_temp_mid": self.bat_temp,
        }
        for row in self.rows.values():
            row.slider.valueChanged.connect(lambda _value: self.changed.emit())

        self.setStyleSheet(
            f"""
            QFrame#tuningPanel {{
                border: 1px solid {rgba('#808080', 0.25)};
                border-radius: 12px;
                background: {rgba('#808080', 0.04)};
            }}
            QLabel#tuningTitle {{ font-size: 12pt; font-weight: 700; }}
            QLabel#tuningSubtitle {{
                color: {rgba('#808080', 0.95)};
                font-size: 9pt;
            }}
            QLabel#tuningColumn {{ font-weight: 600; }}
            """
        )

    def values(self) -> dict:
        return {key: row.value() for key, row in self.rows.items()}

    def set_values(self, values: dict) -> None:
        for key, row in self.rows.items():
            row.set_value(values.get(key, TUNING_DEFAULTS[key]))

    def is_dragging(self) -> bool:
        return any(row.is_dragging() for row in self.rows.values())


class MainWindow(QWidget):
    def __init__(self, controller: "ThinkQuiet", parent: QWidget | None = None):
        super().__init__(parent)
        self.controller = controller
        self.setWindowTitle("ThinkQuiet")
        self.setWindowIcon(make_app_icon())
        self.resize(580, 440)
        self._buttons: dict[str, ProfileButton] = {}
        self._busy = False
        self._group = QButtonGroup(self)
        self._group.setExclusive(True)
        self._build()

    def _build(self) -> None:
        outer = QVBoxLayout(self)
        outer.setContentsMargins(20, 18, 20, 16)
        outer.setSpacing(14)

        header = QHBoxLayout()
        icon = QLabel()
        icon.setPixmap(make_app_icon().pixmap(48, 48))
        header.addWidget(icon)

        titles = QVBoxLayout()
        titles.setSpacing(0)
        title = QLabel("ThinkQuiet")
        title.setObjectName("title")
        subtitle = QLabel("Profilo energetico e ventola")
        subtitle.setObjectName("subtitle")
        titles.addWidget(title)
        titles.addWidget(subtitle)
        header.addLayout(titles)
        header.addStretch(1)
        outer.addLayout(header)

        grid = QGridLayout()
        grid.setHorizontalSpacing(10)
        grid.setVerticalSpacing(10)
        for index, info in enumerate(self.controller.profiles):
            button = ProfileButton(info)
            button.clicked.connect(
                lambda _checked=False, key=info["key"]: self.controller.apply_profile(key)
            )
            self._group.addButton(button)
            self._buttons[info["key"]] = button
            grid.addWidget(button, index // 2, index % 2)
        outer.addLayout(grid)

        stats = QHBoxLayout()
        stats.setSpacing(8)
        self.stat_temp = StatCard("Temperatura")
        self.stat_freq = StatCard("Frequenza")
        self.stat_fan = StatCard("Ventola")
        self.stat_batt = StatCard("Batteria")
        for card in (self.stat_temp, self.stat_freq, self.stat_fan, self.stat_batt):
            stats.addWidget(card)
        outer.addLayout(stats)

        self.tuning_panel = SeraTuning(self)
        self.tuning_panel.changed.connect(self.controller.on_tuning_changed)
        self.tuning_panel.reset_requested.connect(self.controller.reset_tuning)
        self.tuning_panel.hide()
        outer.addWidget(self.tuning_panel)

        self.warning = QLabel("")
        self.warning.setWordWrap(True)
        self.warning.setStyleSheet("color: #b26a00;")
        self.warning.hide()
        outer.addWidget(self.warning)

        footer = QHBoxLayout()
        self.status_label = QLabel("Pronto")
        self.status_label.setObjectName("subtitle")
        footer.addWidget(self.status_label, 1)
        self.reset_button = QPushButton("Ripristina automatico")
        self.reset_button.setCursor(Qt.PointingHandCursor)
        self.reset_button.clicked.connect(self.controller.reset_auto)
        footer.addWidget(self.reset_button)
        outer.addLayout(footer)

        self.setStyleSheet(
            """
            QLabel#title { font-size: 17pt; font-weight: 700; }
            QLabel#subtitle { color: rgba(128,128,128,0.95); }
            """
        )

    def sync_profile(self, key: str | None) -> None:
        self._group.setExclusive(False)
        for button_key, button in self._buttons.items():
            button.setChecked(button_key == key)
        self._group.setExclusive(True)

    def update_status(self, status: dict) -> None:
        temp = status.get("temp_c")
        freq = status.get("freq_mhz")
        fan = status.get("fan") or {}
        battery = status.get("battery") or {}

        self.stat_temp.value.setText(f"{temp:.0f} °C" if temp is not None else "—")
        self.stat_freq.value.setText(
            f"{freq:,} MHz".replace(",", ".") if freq else "—"
        )

        rpm = fan.get("rpm")
        level = fan.get("level")
        if rpm is not None:
            if rpm == 0:
                self.stat_fan.value.setText("spenta · 0 RPM")
            else:
                self.stat_fan.value.setText(f"{rpm} RPM · liv. {level}")
        else:
            self.stat_fan.value.setText("—")

        percent = battery.get("percent")
        if percent is not None:
            suffix = "AC" if battery.get("ac") else "batt."
            self.stat_batt.value.setText(f"{percent}% · {suffix}")
        else:
            self.stat_batt.value.setText("—")

        self.sync_profile(status.get("profile"))

        warnings = status.get("warnings") or []
        if warnings:
            self.warning.setText("⚠ " + " ".join(warnings))
            self.warning.show()
        else:
            self.warning.hide()

        if status.get("daemon"):
            label = status.get("label") or "Attivo"
            self.status_label.setText(f"{label} · PPD {status.get('ppd') or '—'}")
        else:
            self.status_label.setText("Demone non attivo")

    def update_profiles(self, profiles: list[dict]) -> None:
        for info in profiles:
            button = self._buttons.get(info["key"])
            if button is not None:
                button.setText(f"{info['label']}\n{info.get('desc', '')}")

    def set_tuning_visible(self, visible: bool) -> None:
        if self.tuning_panel.isVisible() != visible:
            self.tuning_panel.setVisible(visible)
            self.adjustSize()

    def set_busy(self, busy: bool, message: str | None = None) -> None:
        self._busy = busy
        for button in self._buttons.values():
            button.setEnabled(not busy)
        self.reset_button.setEnabled(not busy)
        if message:
            self.status_label.setText(message)

    def set_offline(self, offline: bool) -> None:
        if offline:
            for button in self._buttons.values():
                button.setEnabled(False)
            self.reset_button.setEnabled(False)
            self.warning.setText(
                "⚠ ThinkQuiet non risulta installato. Esegui: sudo ./install.sh"
            )
            self.warning.show()
            self.status_label.setText("Helper non raggiungibile")
        elif not self._busy:
            for button in self._buttons.values():
                button.setEnabled(True)
            self.reset_button.setEnabled(True)

    def flash(self, message: str) -> None:
        self.status_label.setText(message)
        QTimer.singleShot(3500, self._restore_status)

    def _restore_status(self) -> None:
        status = self.controller.status
        if status:
            label = status.get("label") or "Attivo"
            self.status_label.setText(
                f"{label} · PPD {status.get('ppd') or '—'}"
                if status.get("daemon")
                else "Demone non attivo"
            )

    def show_error(self, message: str) -> None:
        QMessageBox.warning(self, "ThinkQuiet", message)

    def closeEvent(self, event) -> None:  # noqa: N802 (API Qt)
        if self.controller.tray is not None:
            event.ignore()
            self.hide()
            self.controller.notify_hidden()
        else:
            event.accept()


class ThinkQuiet:
    def __init__(self, qapp: QApplication, show_window: bool, use_tray: bool):
        self.qapp = qapp
        self.profiles = [dict(p) for p in FALLBACK_PROFILES]
        self.by_key = {p["key"]: p for p in self.profiles}
        self.status: dict | None = None
        self.tray: QSystemTrayIcon | None = None
        self.proc: QProcess | None = None
        self._hidden_notice_shown = False

        self.window = MainWindow(self)

        self._tuning_visible = False
        self.tune_timer = QTimer(self.window)
        self.tune_timer.setSingleShot(True)
        self.tune_timer.setInterval(300)
        self.tune_timer.timeout.connect(self._save_tuning)

        if use_tray:
            self._build_tray()

        self.timer = QTimer(self.window)
        self.timer.setInterval(3000)
        self.timer.timeout.connect(self.refresh)
        self.timer.start()

        self.refresh()
        if show_window:
            self.show_window()

    # -- tray -------------------------------------------------------------

    def _build_tray(self) -> None:
        self.tray = QSystemTrayIcon(
            make_letter_icon(AUTO_COLOR, "T"), self.window
        )
        self.tray.setToolTip("ThinkQuiet")

        menu = QMenu()
        self.action_group = QActionGroup(menu)
        self.action_group.setExclusive(True)
        self.actions: dict[str, QAction] = {}
        for info in self.profiles:
            action = QAction(info["label"], menu)
            action.setCheckable(True)
            action.setData(info["key"])
            action.triggered.connect(
                lambda _checked=False, key=info["key"]: self.apply_profile(key)
            )
            self.action_group.addAction(action)
            self.actions[info["key"]] = action
            menu.addAction(action)

        menu.addSeparator()
        open_action = menu.addAction("Apri pannello")
        open_action.triggered.connect(self.show_window)
        reset_action = menu.addAction("Ripristina automatico")
        reset_action.triggered.connect(self.reset_auto)
        menu.addSeparator()
        quit_action = menu.addAction("Esci")
        quit_action.triggered.connect(self.qapp.quit)

        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self._on_tray_activated)
        self.tray.show()

    def _on_tray_activated(self, reason: QSystemTrayIcon.ActivationReason) -> None:
        if reason in (
            QSystemTrayIcon.ActivationReason.Trigger,
            QSystemTrayIcon.ActivationReason.DoubleClick,
        ):
            self.toggle_window()

    def notify_hidden(self) -> None:
        if self.tray is not None and not self._hidden_notice_shown:
            self._hidden_notice_shown = True
            self.tray.showMessage(
                "ThinkQuiet",
                "Continua a funzionare nel vassoio. Clicca l'icona per riaprire.",
                QSystemTrayIcon.MessageIcon.Information,
                3500,
            )

    # -- stato ------------------------------------------------------------

    def fetch_status(self) -> dict | None:
        try:
            proc = subprocess.run(
                [HELPER, "status", "--json"],
                capture_output=True,
                text=True,
                timeout=3,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
        if proc.returncode != 0 or not proc.stdout.strip():
            return None
        try:
            return json.loads(proc.stdout)
        except json.JSONDecodeError:
            return None

    def refresh(self) -> None:
        status = self.fetch_status()
        if status is None:
            self.status = None
            self.window.set_offline(True)
            if self._tuning_visible:
                self._tuning_visible = False
                self.window.set_tuning_visible(False)
            if self.tray is not None:
                self.tray.setToolTip("ThinkQuiet · helper non raggiungibile")
            return

        self.status = status
        self.window.set_offline(False)
        profiles = status.get("profiles")
        if profiles:
            self.profiles = profiles
            self.by_key = {p["key"]: p for p in profiles}
            self.window.update_profiles(profiles)

        key = status.get("profile")
        info = self.by_key.get(key) if key else None
        color = info["color"] if info else AUTO_COLOR
        letter = info["label"][0].upper() if info else "A"

        if self.tray is not None:
            self.tray.setIcon(make_letter_icon(color, letter))
            parts = [f"ThinkQuiet · {status.get('label', 'Automatico')}"]
            temp = status.get("temp_c")
            freq = status.get("freq_mhz")
            fan = status.get("fan") or {}
            if temp is not None:
                parts.append(f"CPU {temp:.0f} °C")
            if freq:
                parts.append(f"{freq} MHz")
            if fan.get("rpm") is not None:
                parts.append(f"Ventola {fan['rpm']} RPM")
            self.tray.setToolTip("\n".join(parts))

        self.action_group_sync(key)
        self.window.update_status(status)

        is_sera = key == "sera"
        if is_sera != self._tuning_visible:
            self._tuning_visible = is_sera
            self.window.set_tuning_visible(is_sera)
        if (
            is_sera
            and not self.window.tuning_panel.is_dragging()
            and not self.tune_timer.isActive()
        ):
            self.window.tuning_panel.set_values(
                status.get("tuning") or TUNING_DEFAULTS
            )

    def on_tuning_changed(self) -> None:
        self.tune_timer.start()
        self.window.status_label.setText("Applico il fine tuning…")

    def _save_tuning(self) -> None:
        values = self.window.tuning_panel.values()
        path = Path(TUNING_FILE)
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(path.name + ".tmp")
            tmp.write_text(json.dumps(values, indent=2) + "\n")
            os.replace(tmp, path)
        except OSError as exc:
            self.window.show_error(
                "Impossibile salvare il fine tuning:\n"
                f"{exc}\n\n"
                "Riesegui l'installazione per creare la cartella scrivibile:\n"
                "sudo ./install.sh"
            )
            return
        self.window.flash("Tuning salvato · applicazione entro 3 s")
        QTimer.singleShot(1600, self.refresh)

    def reset_tuning(self) -> None:
        self.window.tuning_panel.set_values(TUNING_DEFAULTS)
        self._save_tuning()

    def action_group_sync(self, key: str | None) -> None:
        if self.tray is None:
            return
        self.action_group.setExclusive(False)
        for action_key, action in self.actions.items():
            action.setChecked(action_key == key)
        self.action_group.setExclusive(True)

    # -- azioni -----------------------------------------------------------

    def apply_profile(self, key: str) -> None:
        self._start_sudo(["apply", key], f"Applico {self.by_key.get(key, {}).get('label', key)}…")

    def reset_auto(self) -> None:
        self._start_sudo(["stop"], "Ripristino automatico…")

    def _start_sudo(self, args: list[str], message: str) -> None:
        if self.proc is not None:
            return
        self.window.set_busy(True, message)

        proc = QProcess(self.window)
        self.proc = proc
        proc.setProcessChannelMode(QProcess.SeparateChannels)
        proc.finished.connect(lambda code, _status: self._process_finished(code))
        proc.errorOccurred.connect(self._process_error)
        proc.start("sudo", ["-n", HELPER, *args])

    def _process_finished(self, code: int) -> None:
        proc = self.proc
        self.proc = None
        if proc is None:
            return
        stderr = bytes(proc.readAllStandardError()).decode("utf-8", "replace").strip()
        stdout = bytes(proc.readAllStandardOutput()).decode("utf-8", "replace").strip()
        proc.deleteLater()

        self.window.set_busy(False)
        if code == 0:
            self.window.flash("Profilo applicato")
            self.refresh()
        else:
            detail = stderr or stdout or f"Errore (codice {code})"
            if "password is required" in detail or "password" in detail.lower():
                detail += (
                    "\n\nLa regola sudo non è attiva. Reinstalla con:\n"
                    "sudo ./install.sh"
                )
            elif "not found" in detail.lower() or "non trovato" in detail.lower():
                detail += "\n\nThinkQuiet non è installato. Esegui: sudo ./install.sh"
            self.window.show_error(detail)

    def _process_error(self, error: QProcess.ProcessError) -> None:
        if self.proc is None:
            return
        self.proc.deleteLater()
        self.proc = None
        self.window.set_busy(False)
        self.window.show_error(
            f"Impossibile eseguire sudo/thinkquiet ({error}).\n"
            "Verifica l'installazione con: sudo ./install.sh"
        )

    # -- finestra ---------------------------------------------------------

    def show_window(self) -> None:
        self.window.show()
        self.window.raise_()
        self.window.activateWindow()

    def toggle_window(self) -> None:
        if self.window.isVisible():
            self.window.hide()
        else:
            self.show_window()


SERVER_NAME = f"thinkquiet-gui-{os.getuid()}"


def show_existing_instance() -> bool:
    """Se l'app e' gia' nel vassoio, le chiede di mostrare la finestra."""
    socket = QLocalSocket()
    socket.connectToServer(SERVER_NAME)
    if not socket.waitForConnected(300):
        return False
    socket.write(b"show\n")
    socket.flush()
    socket.waitForBytesWritten(300)
    socket.disconnectFromServer()
    return True


def create_single_instance_server(controller: "ThinkQuiet") -> QLocalServer | None:
    # Se non c'e' un'istanza viva, il file del socket puo' essere rimasto
    # da un crash precedente: va rimosso prima di mettersi in ascolto.
    QLocalServer.removeServer(SERVER_NAME)
    server = QLocalServer()
    server.setSocketOptions(QLocalServer.SocketOption.UserAccessOption)
    if not server.listen(SERVER_NAME):
        return None

    def on_new_connection() -> None:
        connection = server.nextPendingConnection()
        if connection is not None:
            connection.readyRead.connect(lambda: connection.readAll())
            connection.disconnected.connect(connection.deleteLater)
        controller.show_window()

    server.newConnection.connect(on_new_connection)
    return server


def main() -> int:
    import argparse

    parser = argparse.ArgumentParser(prog="thinkquiet-gui")
    parser.add_argument("--tray", action="store_true", help="avvia solo nel vassoio")
    parser.add_argument("--no-tray", action="store_true", help="nessuna icona nel vassoio")
    parser.add_argument("--self-test", action="store_true", help="test rapido e uscita")
    args = parser.parse_args()

    app = QApplication(sys.argv[:1])
    app.setApplicationName("ThinkQuiet")
    app.setApplicationDisplayName("ThinkQuiet")
    app.setDesktopFileName("thinkquiet-gui")

    # Se ThinkQuiet e' gia' attivo (di solito nel vassoio), questa seconda
    # esecuzione fa solo aprire la finestra dell'istanza esistente.
    if not args.self_test and show_existing_instance():
        return 0

    use_tray = not args.no_tray and QSystemTrayIcon.isSystemTrayAvailable()
    app.setQuitOnLastWindowClosed(not use_tray)
    # Se manca il vassoio, mostra la finestra anche con --tray: altrimenti
    # l'app resterebbe invisibile.
    controller = ThinkQuiet(
        app, show_window=(not args.tray) or (not use_tray), use_tray=use_tray
    )
    app._thinkquiet_controller = controller  # type: ignore[attr-defined]

    if not args.self_test:
        server = create_single_instance_server(controller)
        if server is None:
            show_existing_instance()
            return 0
        app._thinkquiet_server = server  # type: ignore[attr-defined]

    if args.self_test:
        QTimer.singleShot(700, app.quit)

    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
